{
  "id": "/",
  "name": "160 پاکستانی ریسپیز - M Ijaz GHS 124/NB",
  "short_name": "ریسپیز",
  "description": "پاکستانی کھانوں، بیکری آئٹمز، مٹھائیوں اور مشروبات کی 160 آف لائن ریسپیز۔",

  "start_url": "./",
  "scope": "./",

  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],

  "orientation": "portrait-primary",

  "background_color": "#1B1410",
  "theme_color": "#1B1410",

  "lang": "ur",
  "dir": "rtl",

  "categories": [
    "food",
    "lifestyle",
    "education"
  ],

  "prefer_related_applications": false,
  "related_applications": [],

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "shortcuts": [
    {
      "name": "پسندیدہ ریسپیز",
