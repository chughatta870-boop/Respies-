  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+recipe",
      "url": "./?recipe=%s"
    }
  ],

