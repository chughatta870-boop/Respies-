      "description": "اپنی محفوظ کردہ پسندیدہ ریسپیز دیکھیں",
      "url": "./?view=favorites",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
